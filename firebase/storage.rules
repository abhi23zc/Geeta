rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && 'admin' in request.auth.token && request.auth.token.admin == true; }
    match /music/image-uploads/{uid}/{filename} {
      allow read: if admin();
      allow create: if admin() && resource == null && request.auth.uid == uid && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update: if false;
      allow delete: if admin() && request.auth.uid == uid;
    }
    match /music/images/{image}/{filename} { allow read: if true; allow write: if false; }
    match /music/uploads/{uid}/{filename} {
      allow read: if admin();
      allow create: if admin() && resource == null && request.auth.uid == uid && request.resource.size > 0 && request.resource.size <= 200 * 1024 * 1024
        && request.resource.contentType in ['audio/mpeg', 'audio/mp4'];
      allow update: if false;
      allow delete: if admin() && request.auth.uid == uid;
    }
    match /music/published/{filename} { allow read: if true; allow write: if false; }
    match /drafts/{uid}/{filename} {
      allow read: if admin();
      allow create: if admin() && request.auth.uid == uid && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in ['audio/mpeg', 'audio/mp4'];
      allow update: if false;
      allow delete: if admin();
    }
    match /published/{filename} { allow read: if true; allow write: if false; }
    match /{path=**} { allow read: if admin(); allow write: if false; }
  }
}
