rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && 'admin' in request.auth.token && request.auth.token.admin == true; }
    match /drafts/{id} { allow read, write: if admin(); }
    // Notification documents are only mutated through the authenticated server API.
    match /notificationInstallations/{id} { allow read: if admin(); allow write: if false; }
    match /notificationCampaigns/{path=**} { allow read: if admin(); allow write: if false; }
    match /notificationCodes/{id} { allow read: if admin(); allow write: if false; }
    match /notificationTokens/{id} { allow read: if admin(); allow write: if false; }
    match /notificationControl/{id} { allow read: if admin(); allow write: if false; }
    match /notificationAudit/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read: if admin(); allow write: if false; }
  }
}
