{
  "expo": {
    "name": "Aarambh",
    "slug": "geeta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aarambh-icon-v3.png",
    "scheme": "geeta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/aarambh-icon-v3.png"
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "SCHEDULE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#EFDFC3",
        "foregroundImage": "./assets/images/aarambh-adaptive-v3.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zrf.aarambh",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/aarambh-favicon-v3.png"
    },
    "plugins": [
      "expo-asset",
      "expo-sqlite",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F5",
          "image": "./assets/images/aru-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFF9F5",
            "image": "./assets/images/aru-splash.png"
          }
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#E56B27",
          "defaultChannel": "owner-announcements-v1"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "./plugins/with-alarm-desugaring",
      "./plugins/with-alarm-intents",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a personal background for your jaap practice.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27cf64c0-bfba-4f41-827f-f45402a217f3"
      }
    },
    "owner": "zrf"
  }
}
