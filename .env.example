# Firebase Hosting endpoint after deploying the content backend.
EXPO_PUBLIC_CONTENT_API_URL=https://YOUR_PROJECT.web.app/api/v1/content-window

# Owner-controlled push announcements (Firebase client keys are public configuration).
EXPO_PUBLIC_NOTIFICATION_API_URL=https://YOUR_PROJECT.web.app/api/notifications
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Android Firebase config file for com.zrf.aarambh, supplied at native build time.
GEETA_GOOGLE_SERVICES_FILE=

# RevenueCat public SDK keys (never use a secret server API key here).
# Development defaults to the supplied Test Store key. Set false to test real stores.
EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=true
# Release builds require platform keys; Test Store keys are rejected in release mode.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
